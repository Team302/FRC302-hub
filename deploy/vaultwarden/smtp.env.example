# Optional: copy to smtp.env to let Vaultwarden send invites and sign-in notices by email.
# Leave this file out entirely if you don't want email (blank values stop Vaultwarden starting).
# A Gmail account with an app password works: smtp.gmail.com, 587, starttls.
SMTP_HOST=smtp.gmail.com
SMTP_FROM=team302.passwords@gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=team302.passwords@gmail.com
SMTP_PASSWORD=app-password-here
