# Copy to .env (never commit .env). Values in single quotes are taken literally, which matters
# for ADMIN_TOKEN: it contains $ signs.

# The address people will use, exactly as set up in the Cloudflare Tunnel (https, no trailing /).
DOMAIN=https://vault.example.org

# Mentors' emails, comma-separated: only they can create organizations.
ADMIN_EMAILS=coach@example.org

# Password for the admin page (DOMAIN/admin), stored as a hash. Generate with:
#   docker run --rm -it vaultwarden/server:1.37.4 /vaultwarden hash --preset owasp
# and paste the whole $argon2id$... line between single quotes.
ADMIN_TOKEN='$argon2id$v=19$m=19456,t=2,p=1$REPLACE_WITH_YOUR_HASH'

# Cloudflare Zero Trust → Networks → Tunnels → Create a tunnel → Docker: copy the token from the
# command it shows. Public hostname: the DOMAIN above → Service: http://vaultwarden:80
TUNNEL_TOKEN=
